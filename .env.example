# Скопіюйте у .env.local і заповніть. Файл .env.local НЕ додавати в Git.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Публічна адреса застосунку (для формування посилань-запрошень /invite/<token>)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# НЕ додавайте SUPABASE_SERVICE_ROLE_KEY у змінні з префіксом NEXT_PUBLIC_
# і не використовуйте його в клієнтському коді.
